<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_dark"
    android:orientation="vertical"
    android:gravity="center_vertical"
    android:padding="8dp">

    <!-- Header Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="4dp"
        android:layout_marginBottom="12dp">
            
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="My Latest Report"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />
            
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />
            
        <TextView
            android:id="@+id/widget_live_indicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="● LIVE"
            android:textColor="#FF9800"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Content Frame (Empty vs Data) -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- EMPTY STATE -->
        <LinearLayout
            android:id="@+id/widget_empty_state"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/widget_grid_item_bg"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="16dp"
            android:visibility="gone">
            
            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_check_green" />
                
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="No reports submitted yet."
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginTop="8dp" />
                
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Stay alert and report emergencies."
                android:textColor="#9E9E9E"
                android:textSize="12sp"
                android:textAlignment="center"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <!-- DATA STATE -->
        <LinearLayout
            android:id="@+id/widget_data_state"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_grid_item_bg"
            android:orientation="horizontal"
            android:padding="12dp">
            
            <!-- Left Side: Disaster -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingEnd="8dp">
                
                <ImageView
                    android:id="@+id/widget_disaster_icon"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/widget_icon_flood_bg"
                    android:src="@drawable/ic_flood"
                    android:padding="10dp" />
                    
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="DISASTER"
                    android:textColor="#9E9E9E"
                    android:textSize="9sp"
                    android:layout_marginTop="4dp"
                    android:maxLines="1"
                    android:textStyle="bold" />
                    
                <TextView
                    android:id="@+id/widget_disaster_type"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Flood"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Right Side: Pills -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.6"
                android:orientation="vertical"
                android:gravity="center_vertical">

                <!-- Status Pill -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/widget_pill_bg"
                    android:paddingVertical="4dp"
                    android:paddingHorizontal="8dp"
                    android:layout_marginBottom="4dp">
                    
                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:src="@drawable/ic_check_green" />
                        
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Status"
                        android:textColor="#9E9E9E"
                        android:textSize="11sp"
                        android:layout_marginStart="6dp" />
                        
                    <FrameLayout
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_weight="1" />
                        
                    <TextView
                        android:id="@+id/widget_status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Verified"
                        android:textColor="#00E676"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Rescue Pill -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/widget_pill_bg"
                    android:paddingVertical="4dp"
                    android:paddingHorizontal="8dp"
                    android:layout_marginBottom="4dp">
                    
                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:src="@drawable/ic_rescue_team" />
                        
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Rescue"
                        android:textColor="#9E9E9E"
                        android:textSize="11sp"
                        android:layout_marginStart="6dp" />
                        
                    <FrameLayout
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_weight="1" />
                        
                    <TextView
                        android:id="@+id/widget_rescue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="● Assigned"
                        android:textColor="#FF9800"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Location Pill -->
                <LinearLayout
                    android:id="@+id/widget_location_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/widget_pill_bg"
                    android:paddingVertical="4dp"
                    android:paddingHorizontal="8dp">
                    
                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:src="@drawable/ic_location_pin" />
                        
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Loc"
                        android:textColor="#9E9E9E"
                        android:textSize="11sp"
                        android:layout_marginStart="6dp" />
                        
                    <FrameLayout
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_weight="1" />
                        
                    <TextView
                        android:id="@+id/widget_location"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Dharan-5"
                        android:textColor="#FFFFFF"
                        android:textSize="11sp"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:textStyle="bold" />
                </LinearLayout>

            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <!-- Action Button -->
    <LinearLayout
        android:id="@+id/widget_action_btn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/widget_button_bg"
        android:orientation="horizontal"
        android:gravity="center"
        android:padding="12dp"
        android:layout_marginTop="12dp">
            
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tap to report Emergency"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
